<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/haruhi_surface" />
            <corners android:radius="12dp" />
            <stroke
                android:width="2dp"
                android:color="@color/haruhi_headband_deep" />
            <padding
                android:left="12dp"
                android:top="10dp"
                android:right="12dp"
                android:bottom="10dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#FCFEFF" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/haruhi_stroke_strong" />
            <padding
                android:left="12dp"
                android:top="10dp"
                android:right="12dp"
                android:bottom="10dp" />
        </shape>
    </item>
</selector>
